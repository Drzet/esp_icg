CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

CONFIG_SPIRAM=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# OV9281 native Espressif sensor driver: 2-lane CSI, RAW8, 1280x720 @ 50 fps.
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_CAMERA_OV9281=y
CONFIG_CAMERA_OV9281_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV9281_MIPI_RAW8_640X400_100FPS=n
CONFIG_CAMERA_OV9281_MIPI_RAW8_1280X720_50FPS=y
CONFIG_CAMERA_OV9281_MIPI_DEFAULT_FMT_RAW8_640X400_100FPS=n
CONFIG_CAMERA_OV9281_MIPI_DEFAULT_FMT_RAW8_1280X720_50FPS=y
CONFIG_CAMERA_OV9281_SID_LOW=y

# Explicitly disable the former IMX708/ISP/motor path.
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=n
CONFIG_CAMERA_IMX708=n
CONFIG_CAM_MOTOR_DW9807=n
CONFIG_ESP_VIDEO_ENABLE_CAMERA_MOTOR_CONTROLLER=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_FATFS_ALLOC_PREFER_EXTRAM=n
CONFIG_FATFS_IMMEDIATE_FSYNC=n
